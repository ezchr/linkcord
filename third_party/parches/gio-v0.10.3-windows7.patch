+// legacyPointerUpdate processes a Windows 7 WM_MOUSEMOVE or WM_*BUTTON*
+// message, whose coordinates are in client space.
+func (w *window) legacyPointerUpdate(kind pointer.Kind, wParam, lParam uintptr) {
+	if kind == pointer.Press && !w.config.Focused {
+		windows.SetFocus(w.hwnd)
+	}
+	x, y := coordsFromlParam(lParam)
+	w.ProcessEvent(pointer.Event{
+		Kind:      kind,
+		Source:    pointer.Mouse,
+		Position:  f32.Point{X: float32(x), Y: float32(y)},
+		Buttons:   getLegacyButtons(wParam),
+		Time:      windows.GetMessageTime(),
+		Modifiers: getModifiers(),
+	})
+}
+
+// legacyScrollEvent processes a Windows 7 WM_MOUSEWHEEL or WM_MOUSEHWHEEL
+// message, whose coordinates are in screen space.
+func (w *window) legacyScrollEvent(wParam, lParam uintptr, horizontal bool, kmods key.Modifiers) {
+	x, y := coordsFromlParam(lParam)
+	np := windows.Point{X: int32(x), Y: int32(y)}
+	windows.ScreenToClient(w.hwnd, &np)
+	dist := float32(int16(wParam >> 16))
+	var sp f32.Point
+	if horizontal {
+		sp.X = dist
+	} else if kmods == key.ModShift {
+		sp.X = -dist
+	} else {
+		sp.Y = -dist
+	}
+	w.ProcessEvent(pointer.Event{
+		Kind:      pointer.Scroll,
+		Source:    pointer.Mouse,
+		Position:  f32.Point{X: float32(np.X), Y: float32(np.Y)},
+		Buttons:   getLegacyButtons(wParam),
+		Scroll:    sp,
+		Modifiers: kmods,
+		Time:      windows.GetMessageTime(),
+	})
+}
+
+// getLegacyButtons returns the buttons held according to the MK_* flags in
+// the low word of wParam of a Windows 7 mouse message.
+func getLegacyButtons(wParam uintptr) pointer.Buttons {
+	var btns pointer.Buttons
+	flags := wParam & 0xffff
+	if flags&windows.MK_LBUTTON != 0 {
+		btns |= pointer.ButtonPrimary
+	}
+	if flags&windows.MK_RBUTTON != 0 {
+		btns |= pointer.ButtonSecondary
+	}
+	if flags&windows.MK_MBUTTON != 0 {
+		btns |= pointer.ButtonTertiary
+	}
+	if flags&windows.MK_XBUTTON1 != 0 {
+		btns |= pointer.ButtonQuaternary
+	}
+	if flags&windows.MK_XBUTTON2 != 0 {
+		btns |= pointer.ButtonQuinary
+	}
+	return btns
+}
