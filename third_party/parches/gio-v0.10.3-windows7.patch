+// HasPointerAPI reports whether the WM_POINTER input API, introduced in
+// Windows 8, is available. Setting GIO_LEGACY_MOUSE=1 forces it off so the
+// Windows 7 mouse path can be tested on newer systems.
+func HasPointerAPI() bool {
+	if os.Getenv("GIO_LEGACY_MOUSE") == "1" {
+		return false
+	}
+	return _EnableMouseInPointer.Find() == nil && _GetPointerInfo.Find() == nil
