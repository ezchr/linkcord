+
+// retryWait sleeps with exponential backoff (500ms, 1s, 2s, ... capped at 8s)
+// before attempt i+1. It returns false if ctx ends first.
+func retryWait(ctx context.Context, i uint) bool {
+	d := 500 * time.Millisecond << min(i, 4)
+	t := time.NewTimer(d)
+	defer t.Stop()
+	select {
+	case <-t.C:
+		return true
+	case <-ctx.Done():
+		return false
+	}
+}
