+// SSRC returns the SSRC of this end on the voice server, 0 before it is
+// ready.
+func (s *Session) SSRC() uint32 {
+	s.mut.RLock()
+	gateway := s.gateway
+	s.mut.RUnlock()
+
+	if gateway == nil {
+		return 0
+	}
+	if r := gateway.Ready(); r != nil {
+		return r.SSRC
+	}
+	return 0
+}
