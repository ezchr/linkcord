+// Send sends a command on the voice gateway, such as media sink wants.
+func (s *Session) Send(ctx context.Context, ev ws.Event) error {
+	s.mut.RLock()
+	gateway := s.gateway
+	s.mut.RUnlock()
+
+	if gateway == nil {
+		return ErrCannotSend
+	}
+	return gateway.Send(ctx, ev)
+}
