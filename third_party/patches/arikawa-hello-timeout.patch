 			h.SendHeartbeat(ctx)
 
+		case <-helloTimer.C:
+			if !g.helloSeen {
+				g.SendError(ConnectionError{errors.New("no HELLO from the gateway in time")})
+				g.QueueReconnect()
+			}
+
 		case <-g.reconnect:
